rules_version = '2';

// Ningún cliente (navegador, app) puede leer ni escribir Firestore directamente.
// Todo pasa por la API, que usa Firebase Admin SDK (el Admin SDK no está sujeto a estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
