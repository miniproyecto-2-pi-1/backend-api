# Copia este archivo como .env y llena los valores. El .env real NUNCA se sube al repositorio.

# Puerto local (en Render lo asigna la plataforma automáticamente)
PORT=3000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por coma
# Ejemplo producción: https://tu-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# Service account de Firebase (Consola Firebase → Configuración del proyecto → Cuentas de servicio)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave en UNA sola línea, entre comillas, con los saltos de línea escritos como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tiempo máximo de espera a Firestore (ms) antes de responder 503
FIRESTORE_TIMEOUT_MS=5000
